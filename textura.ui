           <property name="styleSheet">
            <string notr="true">color: rgb(0, 0, 0);</string>
           </property>
           <property name="text">
            <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:12pt; font-weight:600; color:#000000;&quot;&gt;Acerca de TextureSoft&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;TextureSoft en su versión 3.0, es una aplicación desarrollada en lenguaje Python 3.5, con una interfaz gráfica creada en Pyside6-designer.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;La aplicación permite determinar la textura del suelo, basado en la clasificación de USDA, considerando 12 Clases texturales (ver triángulo textural).&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;La versión 3.0 integra una base de datos en SQlite, donde almacena de datos, puede actualizar y eliminar datos, con una interfaz moderna.&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Versión suministrada por Ecoproductivo 2022-2026&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;&lt;a href=&quot;https://ecoproductivo.com/&quot;&gt;&lt;span style=&quot; font-weight:700; text-decoration: underline; color:#308cc6;&quot;&gt;https://ecoproductivo.com&lt;/span&gt;&lt;/a&gt;&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Version: 3.0(x86_64)&lt;/p&gt;&lt;p align=&quot;justify&quot;&gt;Elaborado por: Ing. Richard Estrada&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </widget>
